# Normalize line endings so Windows checkouts stop producing CRLF/LF warnings on every commit.
* text=auto eol=lf

# Binary/generated artifacts: never touch line endings.
*.pdf -text
*.png binary
*.ico binary
*.exe binary
*.dll binary

# Keep GitHub's language bar reflecting actual project code, not the build and launcher scripts.
packaging/rebind.iss linguist-detectable=false
rebind.cmd linguist-detectable=false

# cmd.exe mis-parses multi-line `if (...)` blocks in a batch file with LF endings, and a fresh
# clone would get LF from the eol=lf rule above.
rebind.cmd text eol=crlf
